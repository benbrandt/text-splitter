- "///     println!(\"{}\", x); //"
- "Print 1\n    /// }\n    ///"
- "/// let diff: HashSet<_> ="
- a.difference(&b).collect();
- /// assert_eq!(
- "diff, [1].iter().collect());"
- "///\n    /// // Note that"
- "difference is not symmetric,"
- "/// // and `b - a` means"
- "something else:"
- "/// let diff: HashSet<_> ="
- b.difference(&a).collect();
- /// assert_eq!(
- "diff, [4].iter().collect());"
- "/// ```\n    #[cfg_attr(feature ="
- "\"inline-more\", inline)]"
- "pub fn difference<'a>"
- "(&'a self, other: &'a Self) ->"
- "Difference<'a, T, S, A>"
- "{\n        Difference {"
- "iter: self.iter(),"
- "other,\n        }\n    }"
- /// Visits the values
- representing the symmetric
- "difference,"
- "/// i.e., the values that are in"
- "`self` or in `other` but not in"
- "both.\n    ///\n    /// # Examples"
- "///\n    /// ```\n    /// use"
- "hashbrown::HashSet;"
- "/// let a: HashSet<_> = [1, 2, 3"
- "].into_iter().collect();"
- "/// let b: HashSet<_> = [4, 2, 3"
- ", 4].into_iter().collect();"
- "///\n    /// // Print 1, 4 in"
- arbitrary order.
- /// for x in
- "a.symmetric_difference(&b) {"
- "///     println!(\"{}\", x);"
- "/// }\n    ///\n    /// let diff1:"
- HashSet<_> =
- a.symmetric_difference(&b).
- collect();
- "/// let diff2: HashSet<_> ="
- b.symmetric_difference(&a).
- "collect();\n    ///"
- "/// assert_eq!(diff1, diff2);"
- /// assert_eq!(
- "diff1, [1, 4].iter().collect());"
- "/// ```\n    #[cfg_attr(feature ="
- "\"inline-more\", inline)]"
- "pub fn symmetric_difference<'a>"
- "(&'a self, other: &'a Self) ->"
- "SymmetricDifference<'a, T, S, A>"
