- "iter:"
- self.difference(other).chain
- "(other.difference(self)),"
- "}\n    }\n\n    /// Visits the"
- values representing the
- "intersection,"
- "/// i.e., the values that are"
- "both in `self` and `other`."
- "///\n    /// # Examples\n    ///"
- "/// ```\n    /// use hashbrown::"
- HashSet;
- "/// let a: HashSet<_> = [1, 2, 3"
- "].into_iter().collect();"
- "/// let b: HashSet<_> = [4, 2, 3"
- ", 4].into_iter().collect();"
- "///\n    /// // Print 2, 3 in"
- arbitrary order.
- /// for x in a.intersection(&b)
- "{\n    ///     println!(\"{}\", x);"
- "/// }\n    ///\n    /// let"
- "intersection: HashSet<_> ="
- a.intersection(&b).collect();
- /// assert_eq!(
- "intersection, [2, 3].iter()."
- "collect());\n    /// ```"
- "#[cfg_attr(feature = \"inline-"
- "more\", inline)]"
- "pub fn intersection<'a>"
- "(&'a self, other: &'a Self) ->"
- "Intersection<'a, T, S, A>"
- "{\n        let (smaller, larger)"
- "= if self.len() <= other.len() {"
- "(self, other)"
- "} else {"
- "(other, self)"
- "};\n        Intersection {"
- "iter: smaller.iter(),"
- "other: larger,\n        }\n    }"
- /// Visits the values
- "representing the union,"
- "/// i.e., all the values in `"
- "self` or `other`, without"
- "duplicates.\n    ///"
- "/// # Examples\n    ///"
- "/// ```\n    /// use hashbrown::"
- HashSet;
- "/// let a: HashSet<_> = [1, 2, 3"
- "].into_iter().collect();"
- "/// let b: HashSet<_> = [4, 2, 3"
- ", 4].into_iter().collect();"
- "///\n    /// // Print 1, 2, 3, 4"
- in arbitrary order.
