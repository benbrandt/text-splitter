- borrowed form *must* match those
- "for\n    /// the value type."
- "///\n    /// # Examples\n    ///"
- "/// ```\n    /// use hashbrown::"
- "HashSet;\n    ///"
- "/// let set: HashSet<_> = [1, 2,"
- "3].into_iter().collect();"
- /// assert_eq!(
- "set.contains(&1), true);"
- /// assert_eq!(
- "set.contains(&4), false);"
- "/// ```\n    ///\n    /// [`Eq`]:"
- "https://doc.rust-lang.org/std/"
- cmp/trait.Eq.html
- "/// [`Hash`]: https://doc.rust-"
- lang.org/std/hash/
- trait.Hash.html
- "#[cfg_attr(feature = \"inline-"
- "more\", inline)]"
- "pub fn contains<Q: ?Sized>"
- "(&self, value: &Q) -> bool"
- where
- "Q: Hash + Equivalent<T>,"
- "{\n        self.map.contains_key("
- "value)\n    }"
- /// Returns a reference to the
- "value in the set, if any, that"
- is equal to the given value.
- "///\n    /// The value may be any"
- "borrowed form of the set's value"
- "type, but"
