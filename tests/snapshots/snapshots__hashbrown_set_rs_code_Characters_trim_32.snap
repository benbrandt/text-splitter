- /// assert_eq!(
- "entry.get(), &\"horseyland\");"
- "/// ```\n    #[cfg_attr(feature ="
- "\"inline-more\", inline)]"
- pub fn insert(self) ->
- "OccupiedEntry<'a, T, S, A>"
- "where\n        T: Hash,"
- "S: BuildHasher,"
- "{\n        match self {"
- "Entry::Occupied(entry) => entry,"
- "Entry::Vacant(entry) =>"
- "entry.insert(),\n        }\n    }"
- /// Ensures a value is in the
- entry by inserting if it was
- "vacant.\n    ///"
- "/// # Examples\n    ///"
- "/// ```\n    /// use hashbrown::"
- "HashSet;\n    ///"
- "/// let mut set: HashSet<&str> ="
- "HashSet::new();\n    ///"
- /// // nonexistent key
- "/// set.entry(\"poneyland\")."
- or_insert();
- /// assert!(
- "set.contains(\"poneyland\"));"
- "///\n    /// // existing key"
- "/// set.entry(\"poneyland\")."
- or_insert();
- /// assert!(
- "set.contains(\"poneyland\"));"
- "/// assert_eq!(set.len(), 1);"
- "/// ```\n    #[cfg_attr(feature ="
- "\"inline-more\", inline)]"
- pub fn or_insert(self)
- "where\n        T: Hash,"
- "S: BuildHasher,"
- "{\n        if let Entry::Vacant("
- entry) = self
- "{\n            entry.insert();"
- "}\n    }\n\n    /// Returns a"
- "reference to this entry's value."
- "///\n    /// # Examples\n    ///"
- "/// ```\n    /// use hashbrown::"
- "HashSet;\n    ///"
- "/// let mut set: HashSet<&str> ="
- "HashSet::new();"
- "/// set.entry(\"poneyland\")."
- or_insert();
- /// // existing key
- /// assert_eq!(
- "set.entry(\"poneyland\").get(), &\""
- "poneyland\");"
- /// // nonexistent key
- /// assert_eq!(
- "set.entry(\"horseland\").get(), &\""
- "horseland\");\n    /// ```"
- "#[cfg_attr(feature = \"inline-"
- "more\", inline)]"
- pub fn get(&self) -> &T
- "{\n        match *self {"
- "Entry::Occupied(ref entry) =>"
- "entry.get(),"
- "Entry::Vacant(ref entry) =>"
- "entry.get(),\n        }\n    }\n}"
- "impl<T, S, A: Allocator>"
- "OccupiedEntry<'_, T, S, A>"
- "{\n    /// Gets a reference to"
- "the value in the entry.\n    ///"
- "/// # Examples\n    ///"
- "/// ```\n    /// use hashbrown::"
- "hash_set::{Entry, HashSet};"
- "///\n    /// let mut set: HashSet"
- "<&str> = HashSet::new();"
- "/// set.entry(\"poneyland\")."
- "or_insert();\n    ///"
- "/// match set.entry(\"poneyland\")"
- "{\n    ///     Entry::Vacant(_) ="
- "> panic!(),"
- "///     Entry::Occupied(entry) ="
- "> assert_eq!("
- "entry.get(), &\"poneyland\"),"
- "/// }\n    /// ```\n    #[cfg_attr"
- "(feature = \"inline-more\", inline"
- ")]\n    pub fn get(&self) -> &T {"
- "self.inner.key()\n    }"
- /// Takes the value out of the
- "entry, and returns it."
- /// Keeps the allocated memory
- "for reuse.\n    ///"
- "/// # Examples\n    ///"
- "/// ```\n    /// use hashbrown::"
- HashSet;
- "/// use hashbrown::hash_set::"
- "Entry;\n    ///"
- "/// let mut set: HashSet<&str> ="
- "HashSet::new();"
- /// // The set is empty
- /// assert!(
- set.is_empty() && set.capacity()
- "== 0);\n    ///"
- "/// set.entry(\"poneyland\")."
- or_insert();
- /// let capacity_before_remove =
- "set.capacity();\n    ///"
- "/// if let Entry::Occupied(o) ="
- "set.entry(\"poneyland\") {"
- ///     assert_eq!(
- "o.remove(), \"poneyland\");"
- "/// }\n    ///\n    /// assert_eq!"
- "(set.contains(\"poneyland\"),"
- false);
- /// // Now set hold none
- elements but capacity is equal
- to the old one
- /// assert!(
- set.len() == 0 && set.capacity()
- "== capacity_before_remove);"
- "/// ```\n    #[cfg_attr(feature ="
- "\"inline-more\", inline)]"
- pub fn remove(self) -> T
- "{"
- self.inner.remove_entry().0
- "}\n\n    /// Replaces the entry,"
- returning the old value.
- The new value in the hash map
- will be
- /// the value used to create
- "this entry.\n    ///"
- "/// # Panics\n    ///"
- /// Will panic if this
- OccupiedEntry was created
- "through [`Entry::insert`]."
- "///\n    /// # Examples\n    ///"
- "/// ```\n    ///  use hashbrown::"
- "hash_set::{Entry, HashSet};"
- "///  use std::rc::Rc;\n    ///"
- "///  let mut set: HashSet<Rc<"
- "String>> = HashSet::new();"
- "///  let key_one = Rc::new(\""
- "Stringthing\".to_string());"
- "///  let key_two = Rc::new(\""
- "Stringthing\".to_string());"
- "///\n    ///  set.insert("
- key_one.clone());
- ///  assert!(
- "Rc::strong_count(&key_one) == 2"
- "&& Rc::strong_count(&key_two) =="
- "1);\n    ///"
- ///  match set.entry(
- "key_two.clone()) {"
- "///      Entry::Occupied(entry)"
- "=> {\n    ///          let"
- "old_key: Rc<String> ="
- entry.replace();
- ///          assert!(
- "Rc::ptr_eq(&key_one, &old_key));"
- "///      }\n    ///      Entry::"
- "Vacant(_) => panic!(),"
- "///  }\n    ///\n    ///  assert!("
- "Rc::strong_count(&key_one) == 1"
- "&& Rc::strong_count(&key_two) =="
- 2);
- ///  assert!(
- "set.contains(&\"Stringthing\"."
- "to_owned()));\n    /// ```"
- "#[cfg_attr(feature = \"inline-"
- "more\", inline)]"
- pub fn replace(self) -> T
- "{\n        self.inner.replace_key"
- "()\n    }\n}\n\nimpl<'a, T, S, A:"
- Allocator>
- "VacantEntry<'a, T, S, A>"
- "{\n    /// Gets a reference to"
- the value that would be used
- when inserting
- "/// through the `VacantEntry`."
- "///\n    /// # Examples\n    ///"
- "/// ```\n    /// use hashbrown::"
- "HashSet;\n    ///"
- "/// let mut set: HashSet<&str> ="
- "HashSet::new();"
- /// assert_eq!(
- "set.entry(\"poneyland\").get(), &\""
- "poneyland\");\n    /// ```"
- "#[cfg_attr(feature = \"inline-"
- "more\", inline)]"
- pub fn get(&self) -> &T
- "{\n        self.inner.key()\n    }"
- /// Take ownership of the value.
- "///\n    /// # Examples\n    ///"
- "/// ```\n    /// use hashbrown::"
- "hash_set::{Entry, HashSet};"
- "///\n    /// let mut set: HashSet"
- "<&str> = HashSet::new();\n    ///"
- "/// match set.entry(\"poneyland\")"
- "{\n    ///     Entry::Occupied(_)"
- "=> panic!(),"
- "///     Entry::Vacant(v) =>"
- assert_eq!(
- "v.into_value(), \"poneyland\"),"
- "/// }\n    /// ```\n    #[cfg_attr"
- "(feature = \"inline-more\", inline"
- ")]\n    pub fn into_value(self) -"
- "> T"
- "{\n        self.inner.into_key()"
- "}\n\n    /// Sets the value of the"
- "entry with the VacantEntry's"
- "value.\n    ///"
- "/// # Examples\n    ///"
- "/// ```\n    /// use hashbrown::"
- HashSet;
- "/// use hashbrown::hash_set::"
- "Entry;\n    ///"
- "/// let mut set: HashSet<&str> ="
- "HashSet::new();\n    ///"
- "/// if let Entry::Vacant(o) ="
- "set.entry(\"poneyland\") {"
- "///     o.insert();\n    /// }"
- /// assert!(
- "set.contains(\"poneyland\"));"
- "/// ```\n    #[cfg_attr(feature ="
- "\"inline-more\", inline)]"
- pub fn insert(self) ->
- "OccupiedEntry<'a, T, S, A>"
- "where\n        T: Hash,"
- "S: BuildHasher,"
- "{\n        OccupiedEntry {"
- "inner:"
- "self.inner.insert_entry(()),"
- "}\n    }\n}\n\n#[allow(dead_code)]"
- fn assert_covariance()
- "{\n    fn set<'new>(v: HashSet<&'"
- static str>) ->
- "HashSet<&'new str>"
- "{\n        v\n    }"
- "fn iter<'a, 'new>"
- "(v: Iter<'a, &'static str>) ->"
- "Iter<'a, &'new str>"
- "{\n        v\n    }"
- "fn into_iter<'new, A: Allocator>"
- "(v: IntoIter<&'static str, A>)"
- "-> IntoIter<&'new str, A>"
- "{\n        v\n    }"
- fn difference
- "<'a, 'new, A: Allocator>"
- "(\n        v: Difference<'a, &'"
- "static str, DefaultHashBuilder,"
- "A>,\n    ) ->"
- Difference
- "<'a, &'new str,"
- "DefaultHashBuilder, A>"
- "{\n        v\n    }"
- fn symmetric_difference
- "<'a, 'new, A: Allocator>"
- "(\n        v: SymmetricDifference"
- "<'a, &'static str,"
- "DefaultHashBuilder, A>,\n    ) ->"
- SymmetricDifference
- "<'a, &'new str,"
- "DefaultHashBuilder, A>"
- "{\n        v\n    }"
- fn intersection
- "<'a, 'new, A: Allocator>"
- "(\n        v: Intersection<'a, &'"
- "static str, DefaultHashBuilder,"
- "A>,\n    ) ->"
- Intersection
- "<'a, &'new str,"
- "DefaultHashBuilder, A>"
- "{\n        v\n    }"
- "fn union<'a, 'new, A: Allocator>"
- "(\n        v: Union<'a, &'static"
- "str, DefaultHashBuilder, A>,"
- ") -> Union<'a, &'new str,"
- "DefaultHashBuilder, A>"
- "{\n        v\n    }"
- "fn drain<'new, A: Allocator>"
- "(d: Drain<'static, &'static str,"
- "A>) -> Drain<'new, &'new str, A>"
- "{\n        d\n    }\n}"
- "#[cfg(test)]"
- mod test_set
- "{\n    use super::super::map::"
- DefaultHashBuilder;
- "use super::HashSet;"
- "use std::vec::Vec;\n\n    #[test]"
- fn test_zero_capacities()
- "{\n        type HS = HashSet<i32>"
- ";\n\n        let s = HS::new();"
- "assert_eq!(s.capacity(), 0);"
- "let s = HS::default();"
- "assert_eq!(s.capacity(), 0);"
- let s =
- "HS::with_hasher"
- "(DefaultHashBuilder::default());"
- "assert_eq!(s.capacity(), 0);"
- "let s = HS::with_capacity(0);"
- "assert_eq!(s.capacity(), 0);"
- let s =
- "HS::with_capacity_and_hasher"
- "(0,"
- "DefaultHashBuilder::default());"
- "assert_eq!(s.capacity(), 0);"
- "let mut s = HS::new();"
- s.insert(1);
- s.insert(2);
- s.remove(&1);
- s.remove(&2);
- s.shrink_to_fit();
- "assert_eq!(s.capacity(), 0);"
- "let mut s = HS::new();"
- s.reserve(0);
- "assert_eq!(s.capacity(), 0);"
- "}\n\n    #[test]"
- fn test_disjoint()
- "{\n        let mut xs = HashSet::"
- new();
- "let mut ys = HashSet::new();"
- assert!(xs.is_disjoint(&ys));
- assert!(ys.is_disjoint(&xs));
- assert!(xs.insert(5));
- assert!(ys.insert(11));
- assert!(xs.is_disjoint(&ys));
- assert!(ys.is_disjoint(&xs));
- assert!(xs.insert(7));
- assert!(xs.insert(19));
- assert!(xs.insert(4));
- assert!(ys.insert(2));
- assert!(ys.insert(-11));
- assert!(xs.is_disjoint(&ys));
- assert!(ys.is_disjoint(&xs));
- assert!(ys.insert(7));
- assert!(!xs.is_disjoint(&ys));
- assert!(!ys.is_disjoint(&xs));
- "}\n\n    #[test]"
- fn test_subset_and_superset()
- "{\n        let mut a = HashSet::"
- new();
- assert!(a.insert(0));
- assert!(a.insert(5));
- assert!(a.insert(11));
- assert!(a.insert(7));
- "let mut b = HashSet::new();"
- assert!(b.insert(0));
- assert!(b.insert(7));
- assert!(b.insert(19));
- assert!(b.insert(250));
- assert!(b.insert(11));
- assert!(b.insert(200));
- assert!(!a.is_subset(&b));
- assert!(!a.is_superset(&b));
- assert!(!b.is_subset(&a));
- assert!(!b.is_superset(&a));
- assert!(b.insert(5));
- assert!(a.is_subset(&b));
- assert!(!a.is_superset(&b));
- assert!(!b.is_subset(&a));
- assert!(b.is_superset(&a));
- "}\n\n    #[test]"
- fn test_iterate()
- "{\n        let mut a = HashSet::"
- new();
- for i in 0..32
- "{\n            assert!(a.insert(i"
- "));\n        }\n        let mut"
- "observed: u32 = 0;"
- for k in &a
- "{\n            observed |= 1 << *"
- "k;\n        }"
- assert_eq!
- "(observed, 0xFFFF_FFFF);\n    }"
- "#[test]"
- fn test_intersection()
- "{\n        let mut a = HashSet::"
