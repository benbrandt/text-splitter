- "/// Gets the given value's"
- corresponding entry in the set
- for in-place manipulation.
- "///\n    /// # Examples\n    ///"
- "/// ```\n    /// use hashbrown::"
- HashSet;
- "/// use hashbrown::hash_set::"
- "Entry::*;\n    ///"
- "/// let mut singles = HashSet::"
- new();
- "/// let mut dupes = HashSet::new"
- "();\n    ///\n    /// for ch in \"a"
- "short treatise on fungi\".chars()"
- "{\n    ///     if let Vacant("
- "dupe_entry) = dupes.entry(ch) {"
- "///         // We haven't"
- "already seen a duplicate, so"
- "///         // check if we've at"
- least seen it once.
- ///         match singles.entry(
- "ch) {"
- ///             Vacant(
- "single_entry) => {"
- ///                 // We found
- a new character for the first
- time.
- ///
- single_entry.insert();
- "///             }\n    ///"
- "Occupied(single_entry) => {"
- "///                 // We've"
- "already seen this once, \"move\""
- it to dupes.
- ///
- single_entry.remove();
- ///
- dupe_entry.insert();
- "///             }\n    ///"
- "}\n    ///     }\n    /// }\n    //"
- "/\n    /// assert!(!"
- "singles.contains(&'t') &&"
- "dupes.contains(&'t'));"
- /// assert!(
- "singles.contains(&'u') && !"
- "dupes.contains(&'u'));"
- /// assert!(!
- "singles.contains(&'v') && !"
- "dupes.contains(&'v'));"
- "/// ```\n    #[cfg_attr(feature ="
- "\"inline-more\", inline)]"
- pub fn entry
- "(&mut self, value: T) ->"
- "Entry<'_, T, S, A>"
- "{\n        match self.map.entry("
- value)
- "{\n            map::Entry::"
- Occupied(entry) =>
- "Entry::Occupied"
- "(OccupiedEntry { inner: entry })"
- ",\n            map::Entry::Vacant"
- (entry) =>
- "Entry::Vacant"
- "(VacantEntry { inner: entry }),"
- "}\n    }\n\n    /// Returns `true`"
- "if `self` has no elements in"
- "common with `other`."
- /// This is equivalent to
- checking for an empty
- "intersection.\n    ///"
- "/// # Examples\n    ///"
- "/// ```\n    /// use hashbrown::"
- "HashSet;\n    ///"
- "/// let a: HashSet<_> = [1, 2, 3"
- "].into_iter().collect();"
- "/// let mut b = HashSet::new();"
- "///\n    /// assert_eq!("
- "a.is_disjoint(&b), true);"
- /// b.insert(4);
- /// assert_eq!(
- "a.is_disjoint(&b), true);"
- /// b.insert(1);
- /// assert_eq!(
- "a.is_disjoint(&b), false);"
- "/// ```\n    pub fn is_disjoint(&"
- "self, other: &Self) -> bool"
- "{\n        self.iter().all(|v| !"
- "other.contains(v))\n    }"
- "/// Returns `true` if the set is"
- "a subset of another,"
