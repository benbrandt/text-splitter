- "['b', 'a']);\n    }\n\n    #[test]"
- fn test_eq()
- "{\n        // These constants"
- once happened to expose a bug in
- insert().
- "// I'm keeping them around to"
- prevent a regression.
- "let mut s1 = HashSet::new();"
- s1.insert(1);
- s1.insert(2);
- s1.insert(3);
- "let mut s2 = HashSet::new();"
- s2.insert(1);
- s2.insert(2);
- assert!(s1 != s2);
- s2.insert(3);
- "assert_eq!(s1, s2);\n    }"
- "#[test]"
- fn test_show()
