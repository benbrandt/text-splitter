- assert!(b.insert(1));
- assert!(b.insert(5));
- assert!(b.insert(9));
- assert!(b.insert(13));
- assert!(b.insert(19));
- let mut i = 0;
- let expected =
- "[-2, 1, 3, 5, 9, 11, 13, 16, 19,"
- "24];"
- for x in a.union(&b)
- "{\n            assert!("
- expected.contains(x));
- "i += 1;\n        }"
- "assert_eq!(i, expected.len());"
- "}\n\n    #[test]"
- fn test_from_map()
- "{\n        let mut a = crate::"
- "HashMap::new();"
- "a.insert(1, ());"
- "a.insert(2, ());"
- "a.insert(3, ());"
- "a.insert(4, ());"
