- "}\n\n    #[test]"
- fn test_trivial_drain()
- "{\n        let mut s = HashSet::<"
- "i32>::new();"
- "for _ in s.drain() {}"
- assert!(s.is_empty());
- drop(s);
- let mut s =
- "HashSet::<i32>::new();"
- drop(s.drain());
- "assert!(s.is_empty());\n    }"
- "#[test]"
- fn test_drain()
- "{\n        let mut s: HashSet<_>"
- "= (1..100).collect();"
- // try this a bunch of times to
- "make sure we don't screw up"
- internal state.
- for _ in 0..20
- "{\n            assert_eq!(s.len()"
- ", 99);"
- "{\n                let mut last_i"
- "= 0;"
- let mut d = s.drain();
- "for (i, x) in"
- d.by_ref().take(50).enumerate()
- "{\n                    last_i = i"
- ";\n                    assert!(x"
- "!= 0);\n                }"
- "assert_eq!(last_i, 49);"
- "}\n\n            if !s.is_empty()"
- "{\n                panic!(\"s"
- "should be empty!\");"
- "}\n\n            // reset to try"
- again.
- "s.extend(1..100);\n        }"
- "}\n\n    #[test]"
- fn test_replace()
- "{\n        use core::hash;"
- "#[derive(Debug)]"
- "#[allow(dead_code)]"
- "struct Foo(&'static str, i32);"
- impl PartialEq for Foo
- "{\n            fn eq(&self, other"
- ": &Self) -> bool"
- "{\n                self.0 =="
- "other.0\n            }\n        }"
- "impl Eq for Foo {}"
- "impl hash::Hash for Foo"
- "{\n            fn hash<H: hash::"
- "Hasher>(&self, h: &mut H)"
- "{\n                self.0.hash(h)"
- ";\n            }\n        }"
- "let mut s = HashSet::new();"
- assert_eq!
- "(s.replace(Foo(\"a\", 1)), None);"
- "assert_eq!(s.len(), 1);"
- assert_eq!
- "(s.replace(Foo(\"a\", 2)), Some"
- "(Foo(\"a\", 1)));"
- "assert_eq!(s.len(), 1);"
- let mut it = s.iter();
- assert_eq!
- "(it.next(), Some(&Foo(\"a\", 2)));"
- "assert_eq!(it.next(), None);"
- "}\n\n    #[test]"
- "#[allow(clippy::needless_borrow)"
- "]\n    fn test_extend_ref() {"
- "let mut a = HashSet::new();"
- a.insert(1);
- "a.extend([2, 3, 4]);"
- "assert_eq!(a.len(), 4);"
- assert!(a.contains(&1));
- assert!(a.contains(&2));
- assert!(a.contains(&3));
- assert!(a.contains(&4));
- "let mut b = HashSet::new();"
- b.insert(5);
- b.insert(6);
- a.extend(&b);
- "assert_eq!(a.len(), 6);"
- assert!(a.contains(&1));
- assert!(a.contains(&2));
- assert!(a.contains(&3));
- assert!(a.contains(&4));
- assert!(a.contains(&5));
- "assert!(a.contains(&6));\n    }"
- "#[test]"
- fn test_retain()
- "{\n        let xs = [1, 2, 3, 4,"
- "5, 6];"
- "let mut set: HashSet<i32> ="
- xs.iter().copied().collect();
- set.retain(|&k| k % 2 == 0);
- "assert_eq!(set.len(), 3);"
- assert!(set.contains(&2));
- assert!(set.contains(&4));
- "assert!(set.contains(&6));\n    }"
- "#[test]"
- fn test_extract_if()
- "{\n        {\n            let mut"
- "set: HashSet<i32> ="
- (0..8).collect();
- let drained =
- set.extract_if(|&k| k % 2 == 0);
- let mut out =
- "drained.collect::<Vec<_>>();"
- out.sort_unstable();
- assert_eq!
- "(vec![0, 2, 4, 6], out);"
- "assert_eq!(set.len(), 4);"
- "}\n        {\n            let mut"
- "set: HashSet<i32> ="
- (0..8).collect();
- set.extract_if(|&k| k % 2 == 0).
- for_each(drop);
- assert_eq!
- "(set.len(), 4,"
- "\"Removes non-matching items on"
- "drop\");\n        }\n    }"
- "#[test]"
- fn test_const_with_hasher()
- "{\n        use core::hash::"
- BuildHasher;
- use
- "std::collections::hash_map::"
- DefaultHasher;
- "#[derive(Clone)]"
- struct MyHasher;
- impl BuildHasher for MyHasher
- "{\n            type Hasher ="
- DefaultHasher;
- fn build_hasher(&self) ->
- DefaultHasher
- "{\n                DefaultHasher:"
- ":new()\n            }\n        }"
- "const EMPTY_SET:"
